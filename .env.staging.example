# Copy to .env.staging.local and fill these values from the separate Supabase staging project.
# Never use the production project URL or a service-role key here.
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-publishable-or-anon-key
VITE_APP_ENV=staging
